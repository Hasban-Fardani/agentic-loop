#!/usr/bin/env bash
# al — agentic-loop CLI. Satu titik masuk untuk semua harness.
#
# Semua konfigurasi lewat environment atau .env; lihat `al doctor` untuk nilai
# efektif dan `.env.example` untuk daftar variabel.
set -Eeuo pipefail

# AL_BIN_DIR juga nama variabel config (tujuan symlink CLI). Pakai nama lokal
# supaya `al install` tidak salah membaca direktori bin-nya sendiri sebagai
# preferensi user.
_al_self_dir="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
AL_HOME="${AL_HOME:-$(cd "$_al_self_dir/.." && pwd)}"
export AL_HOME
CMD_DIR="$AL_HOME/core/cmd"

usage() {
  cat <<'EOF'
al — agentic-loop: evidence gate & policy toolkit untuk coding agent

USAGE
  al <command> [args]

EVIDENCE
  run [profile]        jalankan evidence profile (smoke|standard|full)
                       exit 0=PASS 1=FAIL 2=UNKNOWN
  decision             cetak decision + flags dari artifact terakhir
  scan [path]          scanner secret/PII (0=bersih 1=temuan 2=tak terbukti)
  scope [check|show]   tegakkan allowed/forbidden path dari task
  complexity [check]   ukur CCN via lizard (0=dalam budget 1=lewat 2=tak terukur)
  discovery <sub>      start|verify|show — bukti pencarian reuse sebelum koding
  goals <sub>          validate|start|show|verify|findings — Goal → Plan → Tasklist
  github <sub>         validate|decision|list-decisions — Hermes GitHub contract
  verify               self-test policy & permission boundary di repo target
  selftest [pattern]   jalankan test suite toolkit ini sendiri

WORKFLOW
  init                 pasang .agent/ + adapter ke repo ini
  init --aep           pasang pula template AEP v2.1 jika belum ada
  worktree <sub>       add|list|remove|prune — satu issue = satu worktree
  event <type> [k=v]   append event audit (append-only, idempoten)
  metrics [--json]     hitung ulang metrik dari artifact + event
  clean                hapus log kedaluwarsa (artifact tidak disentuh)

SKILL UPSTREAM (opt-in, pinned, non-vendored)
  integrate add <url>[@<ref>] <name>
                       catat manifest upstream di $AL_CONFIG_HOME/integrations/
  integrate list       tampilkan manifest upstream yang terpasang
  integrate doctor     laporkan pin, file skill yang sampai, dan deps yang hilang
  integrate sync <name>  perbarui skill upstream ke ref yang dipin

SETUP
  install [harness]    pasang skill ke harness (claude|codex|cursor|hermes|opencode|all)
  uninstall [harness]  lepas skill
  doctor               laporkan config efektif, tool, harness, dan cek .env safety
  version              cetak versi

ENVIRONMENT
  Semua tunable berawalan AL_. Presedensi:
    default < ~/.config/agentic-loop/config.env < ./.env < environment
  Secret hanya dari environment/.env dan selalu diredaksi dari log & artifact.
  Jangan pernah commit .env — hanya .env.example yang masuk repo.
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  run|scan|event|doctor|init|verify|clean|decision|scope|worktree|metrics|complexity|discovery|integrate|goals|github)
    exec bash "$CMD_DIR/$cmd.sh" "$@" ;;
  selftest)
    exec bash "$AL_HOME/tests/run.sh" "$@" ;;
  install)
    exec bash "$AL_HOME/install.sh" "$@" ;;
  uninstall)
    exec bash "$AL_HOME/install.sh" --uninstall "$@" ;;
  version|--version|-v)
    printf 'agentic-loop %s\n' "$(cat "$AL_HOME/VERSION" 2>/dev/null || echo unknown)" ;;
  help|--help|-h)
    usage ;;
  *)
    printf 'perintah tidak dikenal: %s\n\n' "$cmd" >&2; usage >&2; exit 64 ;;
esac

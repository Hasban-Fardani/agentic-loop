# =============================================================================
# agentic-loop — contoh konfigurasi
#
# Salin ke .env di root repository, lalu isi sesuai kebutuhan:
#     cp .env.example .env
#
# .env ADA DI .gitignore DAN TIDAK BOLEH DI-COMMIT. Hanya file .env.example ini
# yang masuk repository. Jangan pernah menulis nilai secret di sini.
#
# Presedensi (rendah -> tinggi):
#   default bawaan  <  ~/.config/agentic-loop/config.env  <  ./.env  <  environment
#
# Artinya: secret dari CI secret store selalu menang atas file .env, dan
# `AL_PROFILE=full al run` menang atas semuanya. Tidak perlu mengedit script.
# =============================================================================

# --- Kredensial ---------------------------------------------------------------
# JANGAN isi di file ini bila mesin dipakai bersama. Untuk CI, pakai secret store
# masing-masing (GitHub Actions secrets, dsb.) dan biarkan baris ini kosong.
# Token butuh scope: repo (baca/tulis branch feature, buka PR). BUKAN admin,
# BUKAN hak merge ke branch protected.
GITHUB_TOKEN=
# GH_TOKEN=
# AL_GITHUB_TOKEN=

# --- Identitas repo target ----------------------------------------------------
# AL_REPO_ROOT terdeteksi otomatis dari git; set hanya bila perlu override.
# AL_REPO_ROOT=
# AL_AGENT_DIR=.agent
# AL_ADAPTER_DIR=scripts/evidence

# --- Perilaku evidence --------------------------------------------------------
# Profil: smoke (cepat) | standard (PR) | full (high-risk/release)
AL_PROFILE=standard
# Timeout default per step, detik. Per-step bisa dioverride di .agent/evidence.yaml
AL_TIMEOUT_DEFAULT=900
# Tier risiko default bila risk gate tidak menentukan: low | medium | high
AL_RISK_TIER=low
# ID task; biasanya di-set oleh CI atau agent, bukan di file ini.
# AL_TASK_ID=TASK-123

# 1 = worktree kotor menghasilkan UNKNOWN (hasil tak terikat commit).
# Set 0 HANYA untuk eksplorasi lokal, jangan di CI.
AL_STRICT_WORKTREE=1
# 1 = acceptance human_only tanpa approval_ref menolak PASS otomatis.
AL_STRICT_ACCEPTANCE=1

# --- Retention ----------------------------------------------------------------
AL_LOG_RETENTION_DAYS=7
AL_ARTIFACT_RETENTION_DAYS=365
# 1 = legal hold aktif; tidak ada artifact yang boleh dihapus.
AL_LEGAL_HOLD=0

# --- Scanner secret/PII -------------------------------------------------------
# Regex ERE. Tambah pola milikmu tanpa menyentuh script.
# AL_SECRET_PATTERN=
# AL_PII_PATTERN=
# Bentuk yang tampak PII tapi bukan: domain dokumentasi (example.com, *.test),
# user VCS pada URL SSH (git@github.com), noreply@. Perluas bila perlu.
# AL_PII_ALLOW=
# Direktori yang dilewati scanner, dipisah '|'.
# AL_SCAN_EXCLUDE=.git|node_modules|vendor|dist|build|target|.venv
AL_SCAN_MAX_FILE_KB=1024

# Repo fixture menyimpan secret SINTETIS untuk menguji scanner. Set 1 hanya bila
# repo ini memang punya fixture semacam itu, dan hanya untuk path fixture.
AL_ALLOW_FIXTURE_SECRETS=0
AL_FIXTURE_DIR=tests/fixtures

# --- Gate AEP v2.1 (opt-in) ---------------------------------------------------
# Semua default off/optional supaya repo yang sudah jalan tidak berubah perilaku
# sampai pemiliknya sadar mengaktifkannya.

# 1 = `al verify` menuntut record discovery sebelum PR dianggap siap.
AL_REQUIRE_DISCOVERY=0

# Complexity: off | optional | required.
#   optional = ukur kalau lizard ada; kalau tidak, no_op yang dinyatakan eksplisit
#   required = lizard wajib; absen berarti exit 2 (UNKNOWN), bukan lulus
AL_COMPLEXITY_MODE=optional
AL_MAX_CCN=10
AL_MAX_FUNCTION_LINES=60
AL_MAX_PARAMS=5

# Tool opsional. Isi path bila tidak ada di PATH. Nilai '-' berarti
# "anggap tidak ada" — dipakai untuk menguji jalur degradasi.
# AL_LIZARD_COMMAND=
# AL_CODEGRAPH_COMMAND=

# Nama variabel yang nilainya diredaksi dari semua log/artifact. Daftar NAMA,
# bukan nilai. Tambahkan milikmu di sini.
# AL_SECRET_VARS=GITHUB_TOKEN OPENAI_API_KEY MY_CUSTOM_TOKEN

# --- Git / forge --------------------------------------------------------------
AL_GIT_REMOTE=origin
AL_PROTECTED_BRANCH=main
AL_BRANCH_PREFIX=agent
AL_FORGE=github

# --- Lokasi instalasi harness -------------------------------------------------
# Installer memakai ini untuk memasang skill. Override bila layout tidak standar;
# tidak perlu mengubah installer.
# AL_CLAUDE_HOME=$HOME/.claude
# AL_CODEX_HOME=$HOME/.codex
# AL_HERMES_HOME=$HOME/.hermes
# AL_OPENCODE_HOME=$HOME/.config/opencode
# AL_CURSOR_DIR=<repo>/.cursor
# symlink = satu sumber, update via git pull. copy = snapshot beku.
AL_INSTALL_MODE=symlink
# Tujuan symlink CLI `al`. Kosong = pakai ~/.local/bin atau ~/bin bila ada.
# Set ke - untuk tidak memasang CLI ke PATH sama sekali.
# AL_BIN_DIR=

# --- Output -------------------------------------------------------------------
AL_COLOR=auto
AL_QUIET=0
AL_DRY_RUN=0
